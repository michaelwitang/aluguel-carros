@startuml casos-de-uso
left to right direction
actor Cliente
actor Agente
actor Empresa
actor Banco
Empresa --|> Agente
Banco --|> Agente
rectangle "Sistema de Aluguel de Carros" {
  usecase "Cadastrar-se" as UC0
  usecase "Efetuar login" as UC1
  usecase "Manter dados do cliente (CRUD)" as UC2
  usecase "Introduzir pedido" as UC3
  usecase "Modificar pedido" as UC4
  usecase "Consultar pedido / status" as UC5
  usecase "Cancelar pedido" as UC6
  usecase "Avaliar pedido (análise financeira)" as UC7
  usecase "Executar contrato" as UC8
  usecase "Conceder contrato de crédito" as UC9
  usecase "Manter automóveis" as UC10
}
Cliente --> UC0
Cliente --> UC1
Cliente --> UC2
Cliente --> UC3
Cliente --> UC4
Cliente --> UC5
Cliente --> UC6
Agente --> UC0
Agente --> UC1
Agente --> UC4
Agente --> UC5
Agente --> UC7
Agente --> UC8
Agente --> UC10
Banco --> UC9
UC8 <.. UC9 : <<extend>>
@enduml
